{
  "name": "systedo-case",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "dev:local": "cross-env DEV_AUTH=true LOCAL_DB=true next dev",
    "dev:inspect": "cross-env DEV_INSPECT=1 next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fences": "node scripts/lint-fence-drill.mjs",
    "lint:fences:check": "node scripts/lint-fence-drill.mjs --check",
    "typecheck": "tsc --noEmit",
    "typecheck:strict": "tsc --noEmit -p tsconfig.strict.json",
    "typecheck:strict:report": "node scripts/typecheck-strict.mjs",
    "typecheck:strict:check": "node scripts/typecheck-strict.mjs --check",
    "typecheck:strict:accept": "node scripts/typecheck-strict.mjs --accept",
    "check": "npm run typecheck && npm run lint && npm run build",
    "check:fast": "node scripts/check-fast.mjs",
    "check:ci": "npm run adr:check && npm run docs:parity && npm run agents:surface && npm run checkpoint:check && npm run actions:check && npm run sast && npm run merge-gate && npm run contract:ledger:check && npm run context:decay:check && npm run review:agent:gate && npm run llm:gate:check && npm run llm:quality:check && npm run llm:budget:check && npm run seed:check && npm run check && npm run test:unit",
    "check:ci:timed": "node scripts/gate-timings.mjs",
    "gates": "node scripts/gate-remedy.mjs",
    "gates:timings": "node scripts/gate-timings.mjs --report",
    "gates:timings:check": "node scripts/gate-timings.mjs --check",
    "gates:failures": "node scripts/gate-timings.mjs --failures",
    "harness:degradation": "node scripts/harness-degradation.mjs",
    "harness:degradation:check": "node scripts/harness-degradation.mjs --check",
    "harness:drill": "node scripts/harness-degradation.mjs --drill",
    "revert:drill": "node scripts/revert-drill.mjs",
    "revert:drill:list": "node scripts/revert-drill.mjs --list",
    "mutation:drill": "node scripts/mutation-drill.mjs",
    "mutation:drill:list": "node scripts/mutation-drill.mjs --list",
    "flake:drill": "node scripts/flake-drill.mjs",
    "flake:drill:list": "node scripts/flake-drill.mjs --list",
    "interrupt:drill": "node scripts/interrupt-drill.mjs",
    "interrupt:drill:list": "node scripts/interrupt-drill.mjs --list",
    "setup:walk": "node scripts/setup-walk.mjs",
    "setup:walk:fast": "node scripts/setup-walk.mjs --skip-build",
    "doctor": "node scripts/doctor.mjs",
    "checkpoint": "node scripts/agent-checkpoint.mjs",
    "checkpoint:check": "node scripts/agent-checkpoint.mjs --check",
    "adr:check": "node scripts/adr-check.mjs",
    "adr:owner": "node scripts/adr-owner.mjs",
    "adr:owner:check": "node scripts/adr-owner.mjs --check",
    "owners:groups": "node scripts/group-owners.mjs",
    "owners:groups:check": "node scripts/group-owners.mjs --check",
    "autonomy": "node scripts/autonomy.mjs",
    "autonomy:check": "node scripts/autonomy.mjs --check",
    "docs:parity": "node scripts/docs-parity.mjs",
    "api:surface": "node scripts/api-surface.mjs",
    "api:surface:check": "node scripts/api-surface.mjs --check",
    "api:surface:write": "node scripts/api-surface.mjs --write",
    "guidance:budget": "node scripts/guidance-budget.mjs",
    "guidance:budget:check": "node scripts/guidance-budget.mjs --check",
    "guidance:commands": "node scripts/guidance-commands.mjs",
    "guidance:commands:check": "node scripts/guidance-commands.mjs --check",
    "threat:flows": "node scripts/threat-flows.mjs",
    "threat:flows:check": "node scripts/threat-flows.mjs --check",
    "docs:staleness": "node scripts/docs-staleness.mjs",
    "docs:staleness:check": "node scripts/docs-staleness.mjs --check",
    "commit:check": "node scripts/commit-check.mjs",
    "agents:surface": "node scripts/agent-surface.mjs --check",
    "agent:permissions": "node scripts/agent-permissions.mjs",
    "agent:permissions:check": "node scripts/agent-permissions.mjs --check",
    "context:conventions": "node scripts/context-conventions.mjs",
    "context:conventions:check": "node scripts/context-conventions.mjs --check",
    "context:coverage": "node scripts/context-coverage.mjs",
    "context:coverage:check": "node scripts/context-coverage.mjs --check",
    "context:coverage:accept": "node scripts/context-coverage.mjs --accept",
    "context:decay": "node scripts/context-decay.mjs",
    "context:decay:check": "node scripts/context-decay.mjs --check --base origin/master",
    "fences": "node scripts/fence-census.mjs",
    "contract:ledger": "node scripts/contract-ledger.mjs",
    "contract:ledger:check": "node scripts/contract-ledger.mjs --check",
    "review:agent": "node scripts/agent-review.mjs",
    "review:agent:gate": "node scripts/agent-review.mjs --base origin/master",
    "review:agent:history": "node scripts/agent-review-history.mjs",
    "injection:check": "node scripts/injection-drill.mjs --check",
    "injection:drill": "node scripts/injection-drill.mjs",
    "sast": "node scripts/sast.mjs",
    "sast:inventory": "node scripts/sast.mjs --inventory",
    "actions:check": "node scripts/actions-pin.mjs",
    "actions:pin": "node scripts/actions-pin.mjs --update",
    "merge-gate": "node scripts/merge-gate.mjs",
    "env:manifest": "node scripts/env-manifest.mjs",
    "env:manifest:check": "node scripts/env-manifest.mjs --check",
    "protection:check": "node scripts/branch-protection.mjs",
    "protection:verify": "node scripts/branch-protection.mjs --verify",
    "i18n:gate": "node scripts/i18n-gate.mjs",
    "i18n:audit": "node scripts/i18n-audit.mjs",
    "i18n:audit:check": "node scripts/i18n-audit.mjs --check",
    "seed": "node scripts/generate-data.mjs",
    "seed:check": "node scripts/generate-data.mjs --check",
    "seed:local": "node scripts/seed-local-db.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:unit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --conditions react-server --import ./test-llm/setup.mjs --experimental-test-module-mocks --test \"test-unit/**/*.test.mjs\"",
    "test:fast": "node scripts/test-fast.mjs",
    "test:llm": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --conditions react-server --import ./test-llm/setup.mjs --test test-llm/real.test.mjs",
    "test:llm:coverage": "node --test test-llm/coverage.test.mjs",
    "llm:drift": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --conditions react-server --import ./test-llm/setup.mjs scripts/llm-drift.mjs",
    "llm:candidate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --conditions react-server --import ./test-llm/setup.mjs scripts/llm-candidate.mjs",
    "llm:models": "node scripts/llm-model-pin.mjs",
    "llm:models:check": "node scripts/llm-model-pin.mjs --check",
    "llm:gate": "node scripts/llm-gate.mjs",
    "llm:gate:check": "node scripts/llm-gate.mjs --check",
    "llm:list": "node scripts/llm-gate.mjs --list",
    "llm:eval": "node scripts/llm-eval.mjs",
    "llm:eval:update": "node scripts/llm-eval.mjs --update",
    "llm:new": "node scripts/llm-new-tool.mjs",
    "llm:quality": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --conditions react-server --import ./test-llm/setup.mjs test-llm/quality/run.mjs",
    "llm:quality:rejudge": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --conditions react-server --import ./test-llm/setup.mjs test-llm/quality/rejudge.mjs",
    "llm:quality:bake": "node scripts/bake-quality-scores.mjs",
    "llm:quality:check": "node scripts/quality-gate.mjs --check",
    "llm:budget": "node scripts/llm-budget.mjs",
    "llm:budget:check": "node scripts/llm-budget.mjs --check",
    "llm:quality:baseline": "node scripts/quality-gate.mjs --accept",
    "issue:dispatch": "node scripts/issue-dispatch.mjs",
    "hooks:install": "node scripts/install-commit-hooks.mjs",
    "hooks:check": "node scripts/install-commit-hooks.mjs --check",
    "prepare": "husky && node scripts/install-commit-hooks.mjs"
  },
  "dependencies": {
    "@auth/firebase-adapter": "^2.11.2",
    "@google/genai": "^2.21.0",
    "@sentry/nextjs": "^10.69.0",
    "@types/leaflet": "^1.9.22",
    "firebase-admin": "^14.2.0",
    "framer-motion": "^12.42.2",
    "leaflet": "^1.9.4",
    "next": "16.3.3",
    "next-auth": "^5.0.0-beta.31",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.4.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "postcss": "^8.5.10",
    "protobufjs": "^7.6.3",
    "js-yaml": "^4.3.1",
    "nanoid": "^3.3.18",
    "next-auth": {
      "next": "$next"
    },
    "@auth/firebase-adapter": {
      "firebase-admin": "$firebase-admin"
    }
  }
}
