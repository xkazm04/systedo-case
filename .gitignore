# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# local sqlite (campaigns feature, local-dev mode)
/.data

# misc
.DS_Store
*.pem

# debug / logs (logs are the only thing we abstract away here)
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
/test-results
/playwright-report
/blob-report
/playwright/.cache

# claude code tooling — keep the REUSABLE assets committed so they travel to other
# devices: skills/ (incl. the /uat engine), commands/, agents/, CLAUDE.md, shared
# settings.json. Ignore only the transient / device-local parts.
/.claude/logs/
/.claude/worktrees/
/.claude/settings.local.json

# ship-loop working journals — the harness's own state/backlog/journal/decisions
# (agent process notes, not app code or a reusable skill). Its own convention is
# that these stay uncommitted.
# (`/*` rather than `/`: git cannot re-include a file whose parent DIRECTORY is
# excluded, so the directory has to stay listed for the negation below to bite.)
/.claude/ship-loop/*
# …except the overlay, which is project CONFIGURATION for a shared skill, not a
# working note: it declares this repo's gate ladder, value journeys and
# conventions, and every session that does not have it re-derives them by hand.
# Same rule the repo already applies to .claude/perfect/config.md (AGENTS.md
# § AI registry: "Project-specific configuration for a shared skill lives in its
# committed overlay").
!/.claude/ship-loop/config.md

# generated context scan reports — timestamped analysis output. The committed
# artifact is /context-map.json; the scan-report-*.md dumps are transient.
/docs/contexts/scan-report-*.md

# UAT test-run outputs — dated run dirs (verdicts, findings.json, capture scripts).
# The reusable specs in uat/characters and uat/journeys stay committed.
/uat/runs/

# LLM quality-matrix reports — timestamped benchmark artifacts (npm run llm:quality).
/test-llm/quality/reports/

# perfect loop vault (local state, never committed - shared master w/ vibeman agent)
.perfect/

# explorer sweep vault (local state, never committed - same rule as .perfect/)
.explorer/

# impeccable-ignore-start
# Ephemeral output, runtime state, and per-dev overrides.
# Shared artifacts stay tracked: config.json, live/config.json,
# design.json, critique/*.md.
.impeccable/config.local.json
.impeccable/hook.cache.json
.impeccable/hook.pending.json
.impeccable/*.png
.impeccable/live/server.json
.impeccable/live/sessions/
.impeccable/live/previews/
.impeccable/live/annotations/
.impeccable/live/cache/
.impeccable/live/manual-edit-apply-transaction.json
.impeccable/live/manual-edit-events.jsonl
.impeccable/live/manual-edit-evidence/
.impeccable/live/pending-manual-edits.json
.impeccable/live/deferred-svelte-component-accepts.json
.impeccable/live/*.png
# impeccable-ignore-end

# KPI simulation runs (local artifacts, ingested by Personas). The KPI
# DEFINITIONS snapshot is tracked — it is the product's KPI contract — while the
# per-run artifacts stay local.
kpi-sim/*
!kpi-sim/snapshot.json

# Personas app local state (outbox + registered-context list)
.personas/

# outreach loop vault (local state, never committed - see .claude/skills/outreach)
.outreach/

# /consult skill log (counts reach the ai-registry signals lane; the log itself stays local)
.ai/consults.jsonl

# knowledge leads filed back to the ai-registry (collected by leads-collect.mjs; local)
.ai/registry-leads.jsonl

# BEGIN ai-registry linked skills (managed by ai-registry/scripts/link-skills.mjs)
# The links are machine state; the declaration lives in .ai/manifest.yaml `skills:`.
/.claude/skills/consult
/.claude/skills/i18n-translate
/.claude/skills/perfect
/.claude/skills/project-populate
/.claude/skills/scan-sweep
/.claude/skills/tiger
/.claude/skills/uat
# END ai-registry linked skills

# BEGIN ai-registry linked skills (managed by ai-registry/scripts/link-registry.mjs)
# Links are machine state; the declarations live in .ai/manifest.yaml (`skills:` and `knowledge.domains`).
/.claude/skills/architect
/.claude/skills/conform
/.claude/skills/consult
/.claude/skills/explorer
/.claude/skills/i18n-translate
/.claude/skills/onboarding
/.claude/skills/perfect
/.claude/skills/project-populate
/.claude/skills/scan-sweep
/.claude/skills/tiger
/.claude/skills/uat
/.claude/rules/ai-registry-access.md
/.claude/rules/ai-registry-media-generation.md
/.claude/rules/ai-registry-software-engineering.md
# END ai-registry linked skills
.architect/
