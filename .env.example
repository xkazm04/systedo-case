# =============================================================================
#  Adamant — environment reference
# =============================================================================
#  Copy to `.env.local` and fill in what you actually need.
#
#  Almost nothing here is required. The public site runs with an empty file, and
#  every AI operation falls back to a deterministic demo result when no provider
#  is configured — degrading without keys is a product property, not an
#  oversight. `npm run doctor` prints what your current file switches on.
#
#  Fully offline authenticated product (no OAuth, no Firestore, no API key):
#      npm run seed:local && npm run dev:local
#
#  Sections:
#    1. Required for a real (non-offline) deployment
#    2. Secrets and crypto
#    3. AI providers and BYOM
#    4. Local development switches
#    5. Data layer
#    6. Ad platforms
#    7. Social platforms
#    8. Email, alerts and crons
#    9. Creative Studio (images, vision, embeddings)
#   10. Rate limiting and spend ceilings
#   11. Observability
#   12. Misc
# =============================================================================


# =============================================================================
#  1. REQUIRED FOR A REAL (NON-OFFLINE) DEPLOYMENT
# =============================================================================

# Session signing secret for Auth.js v5. No default — without it, no session is
# valid. Generate one per install and never reuse it across deployments:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# --- Self-hosted mode (docs/open-source/self-hosting.md) ---------------------
# SELF_HOSTED=true is an EXPLICIT operator decision, honoured in production. It
# switches sign-in to the operator password below (no Google OAuth needed),
# legalises the local sqlite store as the production data layer (set
# LOCAL_DB=true + an absolute SYSTEDO_DB_FILE), removes every plan meter and
# spend ceiling (you pay your own provider bill), and prefers the keyless
# Claude/Codex CLIs over a Gemini key. It never enables DEV_AUTH.
# The Dockerfile bakes SELF_HOSTED=true and LOCAL_DB=true into the image.
# SELF_HOSTED=true

# Operator sign-in password for self-hosted installs. FAIL-CLOSED: a production
# boot with SELF_HOSTED=true and no password REFUSES TO START unless you also
# set ALLOW_OPEN=1 (an explicit "I want an install with no authentication").
# ADAMANT_OPERATOR_PASSWORD=
# ALLOW_OPEN=1

# Trust the Host header from the incoming request (needed for callback URLs on
# an arbitrary port or behind a reverse proxy).
AUTH_TRUST_HOST=true

# Google OAuth client — Google Cloud Console → APIs & Services → Credentials →
# OAuth 2.0 Client ID, type "Web application". Authorized redirect URI:
#   http://localhost:3000/api/auth/callback/google   (plus your production URL)
# The cloud login provider (self-hosted installs sign in with the operator
# password instead), and mandatory for the Google Ads connector.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Cloud project id — used by firebase-admin (Firestore) in cloud mode.
GOOGLE_CLOUD_PROJECT=

# Canonical site origin for OG tags, canonical links and share URLs.
# Optional: derived automatically on Vercel, otherwise falls back to a default.
NEXT_PUBLIC_SITE_URL=


# =============================================================================
#  2. SECRETS AND CRYPTO
# =============================================================================
#  Both of the secrets below fall back to AUTH_SECRET when unset. That works,
#  but it couples stored ciphertext to session-secret rotation: rotating
#  AUTH_SECRET would make previously stored tokens and keys undecryptable.
#  Set them explicitly BEFORE storing any connector token or model key.

# Encryption key for warehouse/ERP and catalog connector tokens at rest
# (AES-256-GCM, per-token salt — src/lib/inventory/token-crypto.ts).
# NOTE: some comments in the codebase still call this TOKEN_CRYPTO_KEY. This is
# the name the code actually reads.
# CATALOG_TOKEN_SECRET=

# Encryption key for user-supplied BYOM provider keys at rest
# (src/lib/llm/keys/crypto.ts).
# BYOM_KEY_SECRET=

# Comma-separated allowlist of admin email addresses, matched case-insensitively.
# Fails CLOSED: with this unset, nobody is an admin and the operator telemetry
# surfaces are unreachable.
# ADMIN_EMAILS=


# =============================================================================
#  3. AI PROVIDERS AND BYOM
# =============================================================================
#  All LLM text calls go through one chokepoint (src/lib/llm), which switches by
#  environment:
#    • development (npm run dev) → Claude Code CLI (subscription, model "sonnet"),
#      then the Codex CLI (ChatGPT plan) as the keyless fallback. Just have the
#      CLIs installed and logged in (`claude`, `codex login`). No key needed —
#      OPENAI_API_KEY is even stripped from the Codex child so runs bill the
#      flat-rate plan, never the metered platform API.
#    • production                → Google Gemini API (key below; no Codex).
#  With no provider available, tools run in demo mode and the app still works.

# Gemini API key (the production path). Free tier at Google AI Studio:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Production model (default lives in src/lib/llm/models.ts). Uncomment for a
# different model — note that src/lib/llm/cost.ts keys its rates by this name,
# so an unknown name reports zero cost.
# GEMINI_MODEL=gemini-3-flash-preview

# Pin the Claude CLI to a specific model (e.g. while benchmarking).
# CLAUDE_CLI_PIN=opus

# Wall-clock ceiling (ms) for one Codex CLI generation — the CLI has no timeout
# flag, so the app enforces it (default 150000; values under 30000 are treated
# as misconfiguration and floored, so a typo can't kill every call instantly).
# CODEX_TIMEOUT_MS=150000

# --- BYOM keys ---------------------------------------------------------------
# Users normally supply their own provider keys through the app (encrypted at
# rest). These process-level keys exist for benchmarks and operator defaults.
# OPENROUTER_API_KEY=          # required by `npm run llm:quality`
# QWEN_API_KEY=                # Qwen Cloud (DashScope-intl compatible mode)

# --- BYOM endpoints ----------------------------------------------------------
# Override the default base URLs of the BYOM adapters
# (src/lib/llm/byom/adapters.ts). Point OPENAI_BASE_URL or OLLAMA_BASE_URL at a
# local server (Ollama, LM Studio, llama.cpp, vLLM, LiteLLM) to run for free
# with no key at all.
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_SITE_URL=         # sent as HTTP-Referer for OpenRouter attribution
# OPENROUTER_APP_NAME=         # sent as X-Title for OpenRouter attribution

# Enable the per-operation provider/model/reasoning matrix outside production
# (in production it requires the `byom` plan).
# BYOM_MATRIX=true


# =============================================================================
#  4. LOCAL DEVELOPMENT SWITCHES
# =============================================================================
#  DEV_AUTH is IGNORED when NODE_ENV=production, always. LOCAL_DB is too —
#  except under SELF_HOSTED=true, where the sqlite store IS the production
#  data layer (see section 1).

# Skip Google sign-in and authenticate a fixed test user, so /app is usable
# without OAuth configured.
# DEV_AUTH=true
# DEV_AUTH_USER_ID=dev-user
# DEV_AUTH_USER_NAME=Dev Tester
# DEV_AUTH_USER_EMAIL=dev@local.test

# Store users and projects in a local node:sqlite file instead of Firestore, so
# local development needs no Firebase credentials at all. Together with
# DEV_AUTH=true this makes /app fully offline. Requires Node >= 22.5.
#   npm run seed:local     # dev user + sample projects (/app/demo-eshop)
#   npm run dev:local      # = DEV_AUTH=true LOCAL_DB=true next dev
# LOCAL_DB=true


# =============================================================================
#  5. DATA LAYER
# =============================================================================

# Path to the local SQLite database. Default: <cwd>/.data/systedo.db — which is
# a trap for any service launched from a different working directory, since it
# will silently open a different, empty database. Always set an ABSOLUTE path
# outside of local development.
# SYSTEDO_DB_FILE=/data/systedo.db

# --- Firebase Admin (Firestore) — cloud mode ---------------------------------
# Locally, a service-account key at .data/firebase-sa.json is used. In
# production, set the entire key JSON instead:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
#
# In production, Firebase REFUSES to fall back silently to ambient Application
# Default Credentials and fails loudly instead. If your deployment deliberately
# runs on ADC (e.g. Cloud Run with an attached service account), opt in:
# FIREBASE_ALLOW_ADC=true
#
# Standard Google SDK variable — path to a service-account JSON file.
# GOOGLE_APPLICATION_CREDENTIALS=


# =============================================================================
#  6. AD PLATFORMS
# =============================================================================

# --- Google Ads API (live campaign sync) -------------------------------------
# /kampane runs on DEMO data by default. Live data needs a developer token from
# a Google Ads MANAGER account (Tools → API Center); without it, live sync stays
# off and demo data is used. The connector calls the Ads API on behalf of the
# signed-in user (their OAuth token + selected account).
GOOGLE_ADS_DEVELOPER_TOKEN=

# Manager (MCC) customer id, digits only, if accounts sit under an MCC.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# --- Sklik API (Seznam.cz ad platform) ---------------------------------------
# Reads campaigns and daily statistics (data-in only; campaign edits are Google
# Ads only so far). Enabled when a token is set, and used for a signed-in user
# with no connected Google Ads account (Google takes precedence). Without a
# token nothing changes — demo data is used.
# NOTE: currently one token per instance; per-user auth is a planned follow-up.
# Get the token in Sklik → Settings → API.
SKLIK_API_TOKEN=


# =============================================================================
#  7. SOCIAL PLATFORMS
# =============================================================================
#  Per-platform publishing. Each platform is independently configured; an
#  unconfigured platform degrades to a demo connection rather than erroring.
#  You must register your own apps — an open repository cannot ship shared ones.

# META_APP_ID=
# META_APP_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=

# SMTP connection URL for the twin's outbound email connector. Unset means that
# channel degrades to "manual" rather than failing.
# TWIN_SMTP_URL=


# =============================================================================
#  8. EMAIL, ALERTS AND CRONS
# =============================================================================

# Shared secret for the scheduled endpoints under /api/cron/*. Compared
# constant-time and FAILS CLOSED: with no secret set, crons are disabled
# entirely rather than left open. Schedules live in vercel.json.
CRON_SECRET=

# Transactional email via Resend (https://resend.com). Without a key, alerts are
# logged instead of sent.
RESEND_API_KEY=
# ALERT_FROM_EMAIL="Adamant <alerts@your-domain.com>"

# Optional outgoing webhook for alerts and the weekly digest. Slack / Teams /
# Discord incoming webhooks accept the {text} payload this sends. Unset means
# the webhook step is skipped.
# ALERT_WEBHOOK_URL=


# =============================================================================
#  9. CREATIVE STUDIO (IMAGES, VISION, EMBEDDINGS)
# =============================================================================

# Leonardo AI generates images; Gemini vision scores them and picks the best of
# several candidates. Without a key the studio runs in demo mode (deterministic
# SVG placeholders). Key from app.leonardo.ai:
LEONARDO_API_KEY=

# Vision model for image scoring. Defaults to the shared GEMINI_MODEL
# (multimodal). Override only for a different vision model.
# GEMINI_VISION_MODEL=

# Embedding model for the patterns-library RAG search. Must be an embedding
# model, not a chat model. Without embeddings, search degrades to lexical.
# GEMINI_EMBED_MODEL=gemini-embedding-001
# PATTERNS_EMBED_TIMEOUT_MS=

# Firebase Storage bucket for the generated-asset library.
# Default in code: <GOOGLE_CLOUD_PROJECT>.appspot.com
# FIREBASE_STORAGE_BUCKET=


# =============================================================================
#  10. RATE LIMITING AND SPEND CEILINGS
# =============================================================================
#  Cost controls on YOUR provider bill. All optional; defaults shown.
#  Public AI routes (/api/ai, /api/campaigns/analyze) call a paid provider
#  without requiring a login, so they are protected per-IP.

# AI_RATE_PER_MIN=8            # generations per minute per IP
# AI_RATE_PER_DAY=80           # generations per day per IP
# SYNC_RATE_PER_MIN=20         # campaign syncs per minute per IP
# AI_MAX_CONCURRENT=4          # concurrent provider calls in one process
# AI_MAX_BODY_BYTES=16384      # maximum request body size

# Total paid provider operations per day across ALL callers. 0 disables it.
# AI_GLOBAL_DAILY_CEILING=2000

# By default the ceiling FAILS OPEN — if the counter store is unreachable, paid
# calls proceed. Set to 1 to refuse paid calls instead.
# AI_CEILING_FAIL_CLOSED=1

# Trust client-IP headers (X-Forwarded-For et al.). Auto-detected on Vercel.
# Set to true ONLY when a proxy you control rewrites those headers — trusting
# them anywhere else lets a caller forge their own rate-limit identity.
# TRUSTED_PROXY=true
# TRUSTED_PROXY_HOPS=1


# =============================================================================
#  11. OBSERVABILITY
# =============================================================================
#  Nothing here is on by default and nothing phones home without a value.

# --- Sentry (error tracking) -------------------------------------------------
# Without a DSN, Sentry never initialises: no network traffic, no side effects.
# Errors-only mode — no tracing, no build plugin, no source-map upload.
# SENTRY_DSN=                  # server errors (route handlers, server components)
# NEXT_PUBLIC_SENTRY_DSN=      # browser errors (error / global-error boundaries)

# --- LightTrack (self-hosted LLM observability) ------------------------------
# Optional mirroring of every LLM call (text tools, embeddings, Creative Studio)
# to a local or cloud LightTrack server, through the single hook at
# src/lib/llm/telemetry.ts → recordLlmCall. Best-effort and fire-and-forget:
# it never blocks or fails a generation. Active only when LIGHTTRACK_PROJECT
# (dev) or LIGHTTRACK_KEY (enforced/cloud) is set. Default URL is loopback.
# LIGHTTRACK_URL=http://127.0.0.1:8787
# LIGHTTRACK_PROJECT=adamant-dev
# LIGHTTRACK_KEY=
# LIGHTTRACK_SOURCE=systedo
# LIGHTTRACK_ENABLED=false     # hard off, even when otherwise configured


# =============================================================================
#  12. MISC
# =============================================================================

# PROPOSED, NOT YET READ BY THE APP. Once wired, this points the footer at your
# fork so a modified network-facing deployment can satisfy AGPL §13. Tracked in
# docs/open-source/self-hosting.md.
# NEXT_PUBLIC_SOURCE_REPO_URL=

# Disable Next.js's own anonymous telemetry. Recommended for self-hosted builds.
# NEXT_TELEMETRY_DISABLED=1
